[{"id":10206,"date":"2026-06-23T11:55:00","date_gmt":"2026-06-23T19:55:00","guid":{"rendered":"https:\/\/tworiversgallery.ca\/?post_type=programs&#038;p=10206"},"modified":"2026-06-23T13:02:24","modified_gmt":"2026-06-23T21:02:24","slug":"birch-bark-jewelry-2","status":"publish","type":"programs","link":"https:\/\/tworiversgallery.ca\/programs\/birch-bark-jewelry-2\/","title":{"rendered":"Birch Bark Jewelry with Janice Baker &amp; Les Baker"},"content":{"rendered":"\n<h2 class=\"wp-block-heading alignwide has-large-font-size\" style=\"padding-top:var(--wp--preset--spacing--30);font-style:normal;font-weight:400\">Artist Bios:<\/h2>\n\n\n\n<div class=\"wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-798703fa wp-block-columns-is-layout-flex\" style=\"margin-top:var(--wp--preset--spacing--30)\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Janice Baker is a third-generation Canadian of mixed European heritage, with a strong connection to her Norwegian roots.\u00a0 She enjoys time spent in the bush, foraging and harvesting and using natural materials in her art.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Les Baker is a Lheidli T\u2019enneh Elder and past president of the Lheidli \u2018Atsiyan Ink\u2019E \u2018Atsoo Elders Society. Les worked in the sawmill industry in Vanderhoof for 35 years, retiring as a saw filer in 2021, and re-entered the workforce as a Lheidli T\u2019enneh Land Guardian in 2025. Les uses his free time to further his connection with Lehidli and Dakelh people and his focus is on exploring, learning and practicing culture through art. Les considers himself an emerging artist, who takes every opportunity to further develop his skills. Les\u2019 art uses materials from nature &#8211; bone, wood, hides, furs and antlers to create traditional and contemporary Dakelh pieces.<\/p>\n<\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>Artist Bios: Janice Baker is a third-generation Canadian of mixed European heritage, with a strong connection to her Norwegian roots.\u00a0 She enjoys time spent in the bush, foraging and harvesting and using natural materials in her art. Les Baker is a Lheidli T\u2019enneh Elder and past president of the Lheidli \u2018Atsiyan Ink\u2019E \u2018Atsoo Elders Society. Les worked in the sawmill industry in Vanderhoof for 35 years, retiring as a saw filer in 2021, and re-entered the workforce as a Lheidli T\u2019enneh Land Guardian in 2025. Les uses his free time to further his connection with Lehidli and Dakelh people and his focus is on exploring, learning and practicing culture through art. Les considers himself an emerging artist, who takes every opportunity to further develop his skills. Les\u2019 art uses materials from nature &#8211; bone, wood, hides, furs and antlers to create traditional and contemporary Dakelh pieces.<\/p>\n","protected":false},"featured_media":9481,"template":"","meta":{"_acf_changed":false,"_seopress_titles_title":"","_seopress_titles_desc":"","_seopress_robots_index":"","_seopress_robots_follow":"","_seopress_robots_imageindex":"","_seopress_robots_snippet":"","_seopress_robots_primary_cat":"","_seopress_robots_breadcrumbs":"","_seopress_robots_freeze_modified_date":"","_seopress_robots_custom_modified_date":"","_seopress_robots_canonical":"","_seopress_social_fb_title":"","_seopress_social_fb_desc":"","_seopress_social_fb_img":"","_seopress_social_fb_img_attachment_id":0,"_seopress_social_fb_img_width":0,"_seopress_social_fb_img_height":0,"_seopress_social_twitter_title":"","_seopress_social_twitter_desc":"","_seopress_social_twitter_img":"","_seopress_social_twitter_img_attachment_id":0,"_seopress_social_twitter_img_width":0,"_seopress_social_twitter_img_height":0,"_seopress_redirections_value":"","_seopress_redirections_enabled":"","_seopress_redirections_enabled_regex":"","_seopress_redirections_logged_status":"","_seopress_redirections_param":"","_se