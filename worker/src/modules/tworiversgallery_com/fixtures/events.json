[{"id":10129,"date":"2026-06-16T10:50:34","date_gmt":"2026-06-16T18:50:34","guid":{"rendered":"https:\/\/tworiversgallery.ca\/?post_type=events&#038;p=10129"},"modified":"2026-06-16T10:50:37","modified_gmt":"2026-06-16T18:50:37","slug":"blank-canvas-art-club-open-house","status":"publish","type":"events","link":"https:\/\/tworiversgallery.ca\/events\/blank-canvas-art-club-open-house\/","title":{"rendered":"Blank Canvas Art Club Open House"},"content":{"rendered":"\n<div class=\"wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-798703fa wp-block-columns-is-layout-flex\" style=\"margin-top:var(--wp--preset--spacing--30)\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Calling all creative teens and their families to join us for a fun Open House where imagination takes the lead! Come explore our newly rebranded teen art program, help brainstorm a brand-new name, create awesome art, meet new people, and share your ideas for what <strong>YOU<\/strong> want this space to become. All are welcome! This is your chance to be part of something exciting, inspiring, and community-driven! Never been to the Gallery before? We\u2019ll show you around and answer any questions you have!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2726 Create art<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2726 Share ideas for the new program name<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2726 Meet other creative youth &amp; families<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2726 Enter to WIN a gift card just for participating!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Whether you love painting, drawing, crafting, or just hanging out in creative spaces, everyone is welcome. Let\u2019s build a program that reflects the creativity, voices, and energy of our youth community! Come make art. Make connections. Make your mark!<\/p>\n<\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>Calling all creative teens and their families to join us for a fun Open House where imagination takes the lead! Come explore our newly rebranded teen art program, help brainstorm a brand-new name, create awesome art, meet new people, and share your ideas for what YOU want this space to become. All are welcome! This is your chance to be part of something exciting, inspiring, and community-driven! Never been to the Gallery before? We\u2019ll show you around and answer any questions you have! \u2726 Create art \u2726 Share ideas for the new program name \u2726 Meet other creative youth &amp; families \u2726 Enter to WIN a gift card just for participating! Whether you love painting, drawing, crafting, or just hanging out in creative spaces, everyone is welcome. Let\u2019s build a program that reflects the creativity, voices, and energy of our youth community! Come make art. Make connections. Make your mark!<\/p>\n","protected":false},"featured_media":5285,"template":"","meta":{"_acf_changed":false,"_seopress_titles_title":"","_seopress_titles_desc":"","_seopress_robots_index":"","_seopress_robots_follow":"","_seopress_robots_imageindex":"","_seopress_robots_snippet":"","_seopress_robots_primary_cat":"","_seopress_robots_breadcrumbs":"","_seopress_robots_freeze_modified_date":"","_seopress_robots_custom_modified_date":"","_seopress_robots_canonical":"","_seopress_social_fb_title":"","_seopress_social_fb_desc":"","_seopress_social_fb_img":"","_seopress_social_fb_img_attachment_id":0,"_seopress_social_fb_img_width":0,"_seopress_social_fb_img_height":0,"_seopress_social_twitter_title":"","_seopress_social_twitter_desc":"","_seopress_social_twitter_img":"","_seopress_social_twitter_img_attachment_id":0,"_seopress_social_twitter_img_width":0,"_seopress_social_twitter_img_height":0,"_seopress_redirections_value":"","_seopress_redirections_enabled":"","_seopress_redirections_enabled_regex":"","_seopress_redirections_logged_status":"","_seopress_redirections_param":"","_seopress_redi